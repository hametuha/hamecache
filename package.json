{
  "name": "hamecache",
  "version": "0.1.0",
  "author": "fumikito",
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:js": "wp-scripts build ./src/js/purge.js --output-path=./assets/js",
    "build:css": "sass ./src/scss/:./assets/css/ --style=compressed --no-source-map && postcss ./assets/css/*.css --use autoprefixer --replace --no-map",
    "watch": "npm run build:css && wp-scripts start ./src/js/purge.js --output-path=./assets/js",
    "lint": "npm run lint:js",
    "lint:js": "wp-scripts lint-js ./src/js",
    "format:js": "wp-scripts lint-js --fix ./src/js"
  },
  "devDependencies": {
    "@wordpress/scripts": "^37.0.0",
    "autoprefixer": "^10.6.1",
    "globals": "^17.13.0",
    "postcss-cli": "^12.0.0",
    "sass": "^1.106.1"
  },
  "browserslist": [
    "extends @wordpress/browserslist-config"
  ]
}
