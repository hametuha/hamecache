{
	"name": "hametuha/hamecache",
	"description": "A page cache plugin for WordPress. Made by Hametuha.",
	"type": "wordpress-plugin",
	"license": "GPL-3.0-or-later",
	"authors": [
		{
			"name": "fumikito",
			"email": "guy@hametuha.com"
		}
	],
	"scripts": {
		"test": "phpunit",
		"lint": "phpcs --standard=phpcs.ruleset.xml",
		"fix": "phpcbf --standard=phpcs.ruleset.xml",
		"phpstan": "phpstan analyse --memory-limit=1G"
	},
	"minimum-stability": "stable",
	"autoload": {
		"psr-0": {
			"Hametuha\\Hamecache": "app"
		}
	},
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"wp-coding-standards/wpcs": "^3.0",
		"phpstan/phpstan": "^2.1",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"php-stubs/wordpress-stubs": "^6.9",
		"php-stubs/wp-cli-stubs": "^2.10"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
